# Local rehearsal, one persistent Node process only. No Supabase connection yet.
# For phone play, use this laptop's LAN address, e.g. http://192.168.1.42:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional directory for local rehearsal data (default .data/)
# DEMO_DATA_DIR=

# Optional hosted-mode build flag (Netlify sets this in netlify.toml)
# NEXT_PUBLIC_SESSION_MODE=online
# ROOM_STORAGE=postgres
# NETLIFY_DB_URL is a server secret supplied by Netlify; never commit it.
